{
  "name": "llmobi-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler --config wrangler.toml dev",
    "deploy": "wrangler --config wrangler.toml deploy",
    "db:create": "wrangler --config wrangler.toml d1 create llmobi",
    "db:init": "wrangler --config wrangler.toml d1 execute llmobi --remote --file=./schema.sql",
    "db:seed": "wrangler --config wrangler.toml d1 execute llmobi --remote --file=./seed.sql",
    "tail": "wrangler --config wrangler.toml tail",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "miniflare": "5.20261023.3-beta",
    "wrangler": "4.156.0"
  },
  "type": "module"
}
